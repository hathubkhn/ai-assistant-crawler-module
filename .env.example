# Copy to crawler_service/.env
# Docker Compose overrides POSTGRES_*, CELERY_*, BACKEND_API_URL, RESEARCH_ASSISTANT_URL.

# --- Postgres (host: manage.py crawl_arxiv outside Docker) ---
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Celery (host only; Compose uses redis://redis:6379/0) ---
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- LLM keywords (OpenAI-compatible) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- After crawl: venue mapping + Qdrant embed ---
BACKEND_API_URL=http://localhost:8000
INTERNAL_VENUE_MAP_KEY=local-dev-internal
RESEARCH_ASSISTANT_URL=http://localhost:8001
